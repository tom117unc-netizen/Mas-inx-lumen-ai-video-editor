+import { describe, expect, it, vi } from 'vitest'
+import { writeFully } from './export-write'
+
+describe('writeFully', () => {
+  it('continues after partial writes until the whole chunk is written', async () => {
+    const writes: Array<[number, number, number]> = []
+    const sizes = [3, 2, 5]
+    await writeFully(10, 100, async (offset, length, position) => {
+      writes.push([offset, length, position])
+      return sizes.shift()!
+    })
+    expect(writes).toEqual([[0, 10, 100], [3, 7, 103], [5, 5, 105]])
+  })
+
+  it('fails instead of looping forever when a write makes no progress', async () => {
+    await expect(writeFully(10, 0, vi.fn(async () => 0))).rejects.toThrow('stopped accepting data')
+  })
+})
