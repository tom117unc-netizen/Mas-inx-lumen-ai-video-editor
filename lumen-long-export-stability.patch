diff --git a/electron/export-write.ts b/electron/export-write.ts
new file mode 100644
--- /dev/null
+++ b/electron/export-write.ts
@@ -0,0 +1,11 @@
+export type PositionedWrite = (offset: number, length: number, position: number) => Promise<number>
+
+/** Node's fs.write callback may report fewer bytes than requested. */
+export async function writeFully(byteLength: number, position: number, write: PositionedWrite) {
+  let offset = 0
+  while (offset < byteLength) {
+    const written = await write(offset, byteLength - offset, position + offset)
+    if (!Number.isFinite(written) || written <= 0) throw new Error('The export file stopped accepting data.')
+    offset += written
+  }
+}
