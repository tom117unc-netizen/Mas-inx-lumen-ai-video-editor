@@ -0,0 +1,24 @@
+import { describe, expect, it, vi } from 'vitest'
+import { pruneInactiveReaders } from './stills'
+
+describe('pruneInactiveReaders', () => {
+  it('disposes readers for cuts that are no longer visible', () => {
+    const old = { dispose: vi.fn() }
+    const current = { dispose: vi.fn() }
+    const readers = new Map([['old', old], ['current', current]])
+    pruneInactiveReaders(readers, new Set(['current']))
+    expect(old.dispose).toHaveBeenCalledOnce()
+    expect(current.dispose).not.toHaveBeenCalled()
+    expect([...readers.keys()]).toEqual(['current'])
+  })
+
+  it('keeps every reader needed by the current composite frame', () => {
+    const a = { dispose: vi.fn() }
+    const b = { dispose: vi.fn() }
+    const readers = new Map([['a', a], ['b', b]])
+    pruneInactiveReaders(readers, new Set(['a', 'b']))
+    expect(a.dispose).not.toHaveBeenCalled()
+    expect(b.dispose).not.toHaveBeenCalled()
+    expect(readers.size).toBe(2)
+  })
+})
